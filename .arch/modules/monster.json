{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "module": "monster",
  "domain": "モンスターじいさん (@モンジィ)",
  "description": "Monster Ranch stabling facility and home pet companion management. Stables captured monsters (base 50 up to 300 via OverMonster), links with Home pet estate (up to 8 pets), validates custom nicknames, handles P2P monster gifting, and wild releases.",
  "entrypoint": "internal/monster/monster.go",
  "dependencies": [
    {
      "module": "core/character",
      "relation_type": "public_service_call",
      "methods": ["FindByID", "FindByIDForUpdate"],
      "source_ref": "internal/monster/monster.go#CharacterRepository"
    },
    {
      "module": "database",
      "relation_type": "transaction_provider",
      "methods": ["RunInTx"],
      "source_ref": "internal/database/tx.go#TransactionProvider"
    }
  ],
  "transaction_flows": [
    {
      "flow": "BringToHome (モンスターを家に連れて行く)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/monster/monster.go#Service.BringToHome",
      "lock_sequence": [
        { "step": 1, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate" },
        { "step": 2, "target": "character_monsters", "method": "MonsterRepository.FindByIDForUpdate" }
      ]
    },
    {
      "flow": "DepositToBox (ペットを預かり所に戻す)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/monster/monster.go#Service.DepositToBox",
      "lock_sequence": [
        { "step": 1, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate" },
        { "step": 2, "target": "character_monsters", "method": "MonsterRepository.FindByIDForUpdate" }
      ]
    },
    {
      "flow": "SendMonster (モンスターを他のプレイヤーに譲渡)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/monster/monster.go#Service.SendMonster",
      "lock_sequence": [
        { "step": 1, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate" },
        { "step": 2, "target": "character_monsters", "method": "MonsterRepository.FindByIDForUpdate" }
      ]
    }
  ]
}
