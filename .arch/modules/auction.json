{
  "$schema": "https://archify.dev/schema/module.v1.json",
  "module": "auction",
  "tier": 1,
  "description": "Auction hall live P2P trading and direct send/inspect facility without server-side bidding.",
  "package": "internal/auction",
  "implementation_package": "internal/auction",
  "dependencies": [
    {
      "name": "character_repository",
      "target_module": "character",
      "relation_type": "contract_interface",
      "source_ref": "internal/auction/types.go#CharacterRepository"
    },
    {
      "name": "equipment_repository",
      "target_module": "equipment",
      "relation_type": "contract_interface",
      "source_ref": "internal/auction/types.go#EquipmentRepository"
    },
    {
      "name": "inventory_repository",
      "target_module": "inventory",
      "relation_type": "contract_interface",
      "source_ref": "internal/auction/types.go#InventoryRepository"
    },
    {
      "name": "depot_repository",
      "target_module": "depot",
      "relation_type": "contract_interface",
      "source_ref": "internal/auction/types.go#DepotRepository"
    }
  ],
  "transaction_boundaries": [
    {
      "method": "Send",
      "source_ref": "internal/auction/auction.go#Service.Send",
      "transaction_type": "RunInTx",
      "lock_sequence": [
        {
          "table": "characters",
          "tier": 2,
          "mode": "SELECT ... FOR UPDATE (ascending ID order)",
          "note": "Lock sender and target characters ordered by ID to prevent deadlocks"
        },
        {
          "table": "inventory_items",
          "tier": 3,
          "mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
          "note": "Lock sender inventory to consume transferred item"
        },
        {
          "table": "character_depot_items",
          "tier": 5,
          "mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
          "note": "Lock recipient depot to add transferred item"
        }
      ]
    }
  ]
}
