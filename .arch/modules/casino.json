{
  "module": "casino",
  "domain": "Casino multiplayer wagers and departure",
  "description": "C1: SQL accounts, character wins and departure evidence; C2: departure claim (rank 0) -> character fatigue (rank 2) -> pending roster claims (rank 8, ascending ID); C3: shared pots. Wagers publish staged Valkey state before SQL commit. Departure delegates to CommitDeparture, then publishes after SQL commit; room commands resume pending publication and owned GETs stay read-only. Failure limits: docs/architecture/valkey-keyspace.md.",
  "entrypoint": "internal/casino/casino.go",
  "dependencies": [
    {
      "module": "core/character",
      "relation_type": "public_service_call",
      "source_ref": "internal/casino/casino.go#CharacterRepository"
    },
    {
      "module": "database",
      "relation_type": "transaction_provider",
      "source_ref": "internal/casino/casino.go#TransactionProvider"
    },
    {
      "module": "database",
      "relation_type": "repository",
      "source_ref": "internal/casino/casino.go#Repository"
    },
    {
      "module": "valkey",
      "relation_type": "repository",
      "source_ref": "internal/casino/room.go#RoomRepository"
    },
    {
      "module": "database",
      "relation_type": "repository",
      "source_ref": "internal/casino/departure.go#DepartureRepository"
    }
  ],
  "transaction_flows": [
    {
      "flow": "Indian Poker action and settlement",
      "tx_mode": "RunInTx",
      "source_ref": "internal/casino/indian_poker.go#Service.PlayIndianPokerAction"
    },
    {
      "flow": "HighLow action and settlement",
      "tx_mode": "RunInTx",
      "source_ref": "internal/casino/highlow.go#Service.PlayHighLowAction"
    },
    {
      "flow": "Doppel selection, reselection and settlement",
      "tx_mode": "RunInTx",
      "source_ref": "internal/casino/doppel.go#Service.PlayDoppelAction"
    },
    {
      "flow": "Departure evidence and fatigue commit; publication follows this boundary",
      "tx_mode": "RunInTx",
      "source_ref": "internal/database/casino_departure_repository.go#CasinoRepository.CommitDeparture"
    },
    {
      "flow": "Departure acknowledgement releases pending roster claims",
      "tx_mode": "RunInTx",
      "source_ref": "internal/database/casino_departure_repository.go#CasinoRepository.AcknowledgeDeparture"
    }
  ]
}
