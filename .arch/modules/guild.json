{
  "$schema": "https://archify.dev/schema/module.v1.json",
  "module": "guild",
  "tier": 1,
  "description": "Guild founding, dynamic guild points, custom roles, hex color customization, and membership management.",
  "package": "internal/guild",
  "implementation_package": "internal/database",
  "dependencies": [
    {
      "name": "guild_repository",
      "target_module": "database",
      "relation_type": "contract_interface",
      "source_ref": "internal/guild/repository.go#Repository"
    }
  ],
  "transaction_boundaries": [
    {
      "method": "CreateGuild",
      "source_ref": "internal/database/guild_repository.go#GuildRepository.CreateGuild",
      "transaction_type": "RunInTx",
      "lock_sequence": [
        {
          "table": "characters",
          "tier": 2,
          "mode": "UPDATE",
          "note": "Deduct guild founding fee from founder wallet"
        },
        {
          "table": "guilds",
          "tier": 7,
          "mode": "INSERT",
          "note": "Insert guild entity"
        },
        {
          "table": "guild_members",
          "tier": 7,
          "mode": "INSERT",
          "note": "Register founder as leader member"
        }
      ]
    },
    {
      "method": "TransferLeadership",
      "source_ref": "internal/database/guild_repository.go#GuildRepository.TransferLeadership",
      "transaction_type": "RunInTx",
      "lock_sequence": [
        {
          "table": "guilds",
          "tier": 7,
          "mode": "UPDATE",
          "note": "Update guild leader character ID"
        },
        {
          "table": "guild_members",
          "tier": 7,
          "mode": "UPDATE",
          "note": "Update former leader to member role and promote new leader"
        }
      ]
    }
  ]
}
