{
  "module": "store",
  "domain": "プレイヤーストア・町建築バザール・インテリア",
  "description": "Player-built retail boutique and bazaar stall in towns 1-4 with gold/barter listings, wallpaper styling, and custom furniture interiors.",
  "entrypoint": "internal/store/service.go",
  "dependencies": [
    {
      "module": "core/character",
      "relation_type": "public_service_call",
      "methods": [
        "FindByID",
        "FindByIDForUpdate",
        "Update"
      ],
      "source_ref": "internal/store/repository.go#CharacterRepository"
    },
    {
      "module": "depot",
      "relation_type": "public_service_call",
      "methods": [
        "FindByCharacterID",
        "FindByCharacterIDForUpdate",
        "Save"
      ],
      "source_ref": "internal/store/repository.go#DepotRepository"
    },
    {
      "module": "core/item",
      "relation_type": "catalog_data",
      "methods": [
        "FindByID",
        "FindByName"
      ],
      "source_ref": "internal/store/repository.go#ItemCatalog"
    },
    {
      "module": "database",
      "relation_type": "transaction_provider",
      "methods": [
        "RunInTx"
      ],
      "source_ref": "internal/store/repository.go#TxProvider"
    }
  ],
  "transaction_flows": [
    {
      "flow": "BuildStore (店舗建築)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/service.go#Service.BuildStore",
      "lock_sequence": [
        {"step": 1, "target": "store_name_lock", "lock_order": 0, "method": "StoreRepository.LockStoreNamesForUpdate", "mode": "INSERT ... ON DUPLICATE KEY UPDATE (row lock)"},
        {"step": 2, "target": "store_town_capacity_lock", "lock_order": 0, "method": "StoreRepository.LockTownCapacityForUpdate", "mode": "INSERT ... ON DUPLICATE KEY UPDATE (row lock)"},
        {"step": 3, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 4, "target": "character_stores", "method": "StoreRepository.CountActiveTownStores", "mode": "SELECT"},
        {"step": 5, "target": "character_stores", "method": "StoreRepository.GetStoreByCharacterID", "mode": "SELECT"},
        {"step": 6, "target": "character_stores", "method": "StoreRepository.ActiveStoreNameExists", "mode": "SELECT"},
        {"step": 7, "target": "characters", "method": "CharacterRepository.Update", "mode": "UPDATE"},
        {"step": 8, "target": "guilds", "method": "GuildPointsRegistrar.AddGuildPoints", "mode": "UPDATE"},
        {"step": 9, "target": "character_stores", "method": "StoreRepository.SaveStore", "mode": "UPSERT"}
      ]
    },
    {
      "flow": "ChangeStoreName (看板変更)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/customization.go#Service.ChangeStoreName",
      "lock_sequence": [
        {"step": 1, "target": "store_name_lock", "lock_order": 0, "method": "StoreRepository.LockStoreNamesForUpdate", "mode": "INSERT ... ON DUPLICATE KEY UPDATE (row lock)"},
        {"step": 2, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 3, "target": "character_stores", "method": "StoreRepository.GetStoreByCharacterID", "mode": "SELECT"},
        {"step": 4, "target": "character_stores", "method": "StoreRepository.ActiveStoreNameExists", "mode": "SELECT"},
        {"step": 5, "target": "character_stores", "method": "StoreRepository.SaveStore", "mode": "UPSERT"}
      ]
    },
    {
      "flow": "BuyItem (ゴールド購入)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/sales.go#Service.BuyItem",
      "lock_sequence": [
        {"step": 1, "target": "store_sales", "lock_order": 0, "method": "StoreRepository.GetSaleByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 2, "target": "character_stores", "method": "StoreRepository.GetStoreByID", "mode": "SELECT"},
        {"step": 3, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate (min(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 4, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate (max(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 5, "target": "character_depots / depot_items", "lock_order": 5, "method": "DepotRepository.FindByCharacterIDForUpdate (buyer)", "mode": "SELECT ... FOR UPDATE"},
        {"step": 6, "target": "characters", "method": "CharacterRepository.Update (both)", "mode": "UPDATE"},
        {"step": 7, "target": "character_depots / depot_items", "method": "DepotRepository.Save (buyer)", "mode": "UPDATE"},
        {"step": 8, "target": "store_sales", "method": "StoreRepository.DeleteSale", "mode": "DELETE"}
      ]
    },
    {
      "flow": "TradeItem (物々交換)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/sales.go#Service.TradeItem",
      "lock_sequence": [
        {"step": 1, "target": "store_sales", "lock_order": 0, "method": "StoreRepository.GetSaleByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 2, "target": "character_stores", "method": "StoreRepository.GetStoreByID", "mode": "SELECT"},
        {"step": 3, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate (min(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 4, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate (max(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 5, "target": "character_depots / depot_items", "lock_order": 5, "method": "DepotRepository.FindByCharacterIDForUpdate (min(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 6, "target": "character_depots / depot_items", "lock_order": 5, "method": "DepotRepository.FindByCharacterIDForUpdate (max(buyer,seller))", "mode": "SELECT ... FOR UPDATE"},
        {"step": 7, "target": "character_depots / depot_items", "method": "DepotRepository.Save (both)", "mode": "UPDATE"},
        {"step": 8, "target": "store_sales", "method": "StoreRepository.DeleteSale", "mode": "DELETE"}
      ]
    },
    {
      "flow": "BuyCostumeItem (衣装アイテム購入)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/oracle.go#Service.BuyCostumeItem",
      "lock_sequence": [
        {"step": 1, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 2, "target": "character_depots / depot_items", "lock_order": 5, "method": "DepotRepository.FindByCharacterIDForUpdate (overflow only)", "mode": "SELECT ... FOR UPDATE"},
        {"step": 3, "target": "characters", "method": "CharacterRepository.Update", "mode": "UPDATE"},
        {"step": 4, "target": "character_depots / depot_items", "method": "DepotRepository.Save (overflow only)", "mode": "UPDATE"}
      ]
    },
    {
      "flow": "BuyHomeWallpaper (壁紙購入)",
      "tx_mode": "RunInTx",
      "source_ref": "internal/store/oracle.go#Service.BuyHomeWallpaper",
      "lock_sequence": [
        {"step": 1, "target": "characters", "lock_order": 2, "method": "CharacterRepository.FindByIDForUpdate", "mode": "SELECT ... FOR UPDATE"},
        {"step": 2, "target": "characters", "method": "CharacterRepository.Update", "mode": "UPDATE"}
      ]
    }
  ]
}
