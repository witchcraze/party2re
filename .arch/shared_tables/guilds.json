{
  "$schema": "https://archify.dev/schema/shared_table.v1.json",
  "table": "guilds",
  "tier": 7,
  "description": "Guild entities, founding leadership, dynamic points, and color customization.",
  "repository_implementation": "internal/database/guild_repository.go#GuildRepository",
  "consumer_interfaces": [
    "internal/guild/repository.go#Repository"
  ],
  "callers": [
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.CreateGuild",
      "lock_mode": "INSERT",
      "lock_order": 7,
      "purpose": "Insert new guild entity"
    },
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.TransferLeadership",
      "lock_mode": "UPDATE",
      "lock_order": 7,
      "purpose": "Update guild leader character ID"
    },
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.UpdateMark",
      "lock_mode": "UPDATE",
      "lock_order": 7,
      "purpose": "Update guild mark and last_active_at"
    },
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.UpdateWallpaper",
      "lock_mode": "UPDATE",
      "lock_order": 7,
      "purpose": "Update guild wallpaper and last_active_at"
    }
  ]
}
