{
  "$schema": "https://archify.dev/schema/shared_table.v1.json",
  "table": "characters",
  "tier": 2,
  "description": "Primary player character state, attributes, wallet money, and progression.",
  "repository_implementation": "internal/database/character_repository.go#CharacterRepository",
  "consumer_interfaces": [
    "internal/shop/shop.go#CharacterRepository",
    "internal/blacksmith/blacksmith.go#CharacterRepository",
    "internal/tavern/tavern.go#CharacterRepository",
    "internal/adventure/adventure.go#CharacterRepository",
    "internal/blackmarket/blackmarket.go#CharacterRepository",
    "internal/fleamarket/fleamarket.go#CharacterRepository",
    "internal/gemstore/types.go#CharacterRepository",
    "internal/bank/bank.go#Repository",
    "internal/auction/types.go#CharacterRepository"
  ],
  "callers": [
    {
      "module": "shop",
      "caller_method": "internal/shop/purchase.go#Service.Purchase",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet and verify sufficient funds"
    },
    {
      "module": "shop",
      "caller_method": "internal/shop/shop.go#Service.Sell",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet"
    },
    {
      "module": "bank",
      "caller_method": "internal/database/bank_repository.go#BankRepository.Deposit",
      "lock_mode": "SELECT ... FOR UPDATE",
      "lock_order": 2,
      "purpose": "Deduct gold from character wallet and add to character deposit"
    },
    {
      "module": "bank",
      "caller_method": "internal/database/bank_repository.go#BankRepository.Withdraw",
      "lock_mode": "SELECT ... FOR UPDATE",
      "lock_order": 2,
      "purpose": "Deduct from character deposit, clamp character money to 999,999G and refund excess"
    },
    {
      "module": "blacksmith",
      "caller_method": "internal/blacksmith/blacksmith.go#Service.Enhance",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet and verify enhancement fee"
    },
    {
      "module": "auction",
      "caller_method": "internal/auction/auction.go#Service.Send",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate, ascending ID order)",
      "lock_order": 2,
      "purpose": "Lock sender and target characters ascending by ID for P2P trading and gold transfer"
    },
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.CreateGuild",
      "lock_mode": "UPDATE",
      "lock_order": 2,
      "purpose": "Deduct guild founding fee from founder wallet"
    },
    {
      "module": "guild",
      "caller_method": "internal/database/guild_repository.go#GuildRepository.Donate",
      "lock_mode": "UPDATE",
      "lock_order": 2,
      "purpose": "Deduct donated gold from character wallet"
    },
    {
      "module": "tavern",
      "caller_method": "internal/tavern/order.go#Service.OrderMeal",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet and verify gold balance"
    },
    {
      "module": "tavern",
      "caller_method": "internal/tavern/delivery.go#Service.ClaimDelivery",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character to restore HP/MP and update fullness"
    },
    {
      "module": "adventure",
      "caller_method": "internal/adventure/adventure.go#Service.StartStage",
      "lock_mode": "SELECT / UPDATE",
      "lock_order": 2,
      "purpose": "Verify character level requirement against stage min level and apply rewards upon crawl completion"
    },
    {
      "module": "blackmarket",
      "caller_method": "internal/blackmarket/blackmarket.go#Service.SacrificeItem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character and verify eligibility"
    },
    {
      "module": "blackmarket",
      "caller_method": "internal/blackmarket/blackmarket.go#Service.TradePrize",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character and verify eligibility"
    },
    {
      "module": "fleamarket",
      "caller_method": "internal/fleamarket/fleamarket.go#Service.CreateListing",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock seller character"
    },
    {
      "module": "fleamarket",
      "caller_method": "internal/fleamarket/fleamarket.go#Service.PurchaseListing",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock buyer and seller characters in ascending ID order to transfer gold"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/trade.go#Service.BuyGem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet and verify funds"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/trade.go#Service.SellGem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character wallet"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/transfer.go#Service.SendGem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock sender and recipient characters in ascending ID order"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/synthesis.go#Service.SynthesizeGem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/synthesis.go#Service.AppraiseItem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByIDForUpdate)",
      "lock_order": 2,
      "purpose": "Lock character"
    }
  ]
}
