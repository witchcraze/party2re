{
  "$schema": "https://archify.dev/schema/shared_table.v1.json",
  "table": "inventory_items",
  "tier": 3,
  "description": "Character item inventory instances, quantities, enhancements, and slot states.",
  "repository_implementation": "internal/database/inventory_repository.go#InventoryRepository",
  "consumer_interfaces": [
    "internal/shop/shop.go#InventoryRepository",
    "internal/blacksmith/blacksmith.go#InventoryRepository",
    "internal/adventure/adventure.go#InventoryRepository",
    "internal/blackmarket/blackmarket.go#InventoryRepository",
    "internal/gemstore/types.go#InventoryRepository",
    "internal/auction/types.go#InventoryRepository"
  ],
  "callers": [
    {
      "module": "shop",
      "caller_method": "internal/shop/purchase.go#Service.Purchase",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to verify slot capacity and grant purchased item"
    },
    {
      "module": "shop",
      "caller_method": "internal/shop/shop.go#Service.Sell",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to verify item ownership and deduct sold item"
    },
    {
      "module": "blacksmith",
      "caller_method": "internal/blacksmith/blacksmith.go#Service.Enhance",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to consume enhancement materials and update equipment level"
    },
    {
      "module": "auction",
      "caller_method": "internal/auction/auction.go#Service.Send",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock sender inventory and consume transferred item instance"
    },
    {
      "module": "blackmarket",
      "caller_method": "internal/blackmarket/blackmarket.go#Service.SacrificeItem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to verify ownership and deduct sacrificed rare item"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/synthesis.go#Service.SynthesizeGem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to consume ingredients"
    },
    {
      "module": "gemstore",
      "caller_method": "internal/gemstore/synthesis.go#Service.AppraiseItem",
      "lock_mode": "SELECT ... FOR UPDATE (FindByCharacterIDForUpdate)",
      "lock_order": 3,
      "purpose": "Lock inventory to consume unidentified orb"
    }
  ]
}
