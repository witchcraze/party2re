FROM golang:1.26.7-trixie

WORKDIR /workspace

COPY go.mod ./
RUN go mod download

COPY . .

CMD ["sh", "-c", "timeout_arg=\"-timeout=30m\"; case \" ${GOFLAGS:-} \" in *' -timeout='*|*' -test.timeout='*) timeout_arg=\"\" ;; esac; if [ -n \"${TEST_TIMEOUT:-}\" ]; then timeout_arg=\"-timeout=${TEST_TIMEOUT}\"; elif [ -n \"${PARTY2_TEST_TIMEOUT:-}\" ]; then timeout_arg=\"-timeout=${PARTY2_TEST_TIMEOUT}\"; fi; exec go test ${timeout_arg} \"$@\"", "--", "./..."]
