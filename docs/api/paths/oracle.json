        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Inspect Oracle NPC @ラクル",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
