{
  "/characters/{id}/oracle": {
    "get": {
      "description": "Returns Oracle Shop status, costume catalog gated by job level, home wallpapers, and current active costume rental.",
      "operationId": "getOracleStatus",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "active_costume": {
                    "nullable": true,
                    "properties": {
                      "expires_at": {
                        "format": "date-time",
                        "nullable": true,
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "item_no": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "character_id": {
                    "type": "string"
                  },
                  "items": {
                    "items": {
                      "properties": {
                        "gender": {
                          "type": "integer"
                        },
                        "icon": {
                          "type": "string"
                        },
                        "item_no": {
                          "type": "integer"
                        },
                        "job_req": {
                          "type": "integer"
                        },
                        "name": {
                          "type": "string"
                        },
                        "price": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "item_no",
                        "name",
                        "price",
                        "gender",
                        "icon",
                        "job_req"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "location_name": {
                    "type": "string"
                  },
                  "npc_name": {
                    "type": "string"
                  },
                  "wallpapers": {
                    "items": {
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "image": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "price": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "price",
                        "image"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "character_id",
                  "location_name",
                  "npc_name",
                  "items",
                  "wallpapers"
                ],
                "type": "object"
              }
            }
          },
          "description": "Oracle Shop status retrieved successfully"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Get Oracle Shop status, costume catalog, wallpapers, and active rental",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
  "/characters/{id}/oracle/blackmarket": {
    "post": {
      "description": "Checks if character meets level requirements to discover Black Market from Oracle Shop hint.",
      "operationId": "discoverOracleBlackMarket",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "unlocked": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "unlocked",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "Black Market discovery eligibility verified"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character job level insufficient (requires job_lv \u003e= 15)"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Check Black Market discovery from Oracle Shop",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
  "/characters/{id}/oracle/buy": {
    "post": {
      "description": "Purchases a costume consumable item from Oracle Shop with gold. Delivers to inventory (or routes overflow to depot) and records in item collection.",
      "operationId": "buyOracleCostume",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "item_no": {
                  "description": "Costume item number (e.g. 44..56, 138..141)",
                  "type": "integer"
                }
              },
              "required": [
                "item_no"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "delivered_to": {
                    "description": "Destination where item was delivered (inventory or depot)",
                    "type": "string"
                  },
                  "item_name": {
                    "type": "string"
                  },
                  "item_no": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "price": {
                    "type": "integer"
                  }
                },
                "required": [
                  "item_no",
                  "item_name",
                  "price",
                  "delivered_to",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "Costume purchased successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Insufficient gold, unavailable costume item, active helper quest conflict, or depot full"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Buy a costume consumable item",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
