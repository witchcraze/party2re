{
  "/characters/{id}/oracle": {
    "get": {
      "description": "Returns Oracle Shop status, costume catalog gated by job level, home wallpapers, and current active costume rental.",
      "operationId": "getOracleStatus",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/StoreOracleStatus"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "Oracle Shop status retrieved successfully"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Bad Request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Get Oracle Shop status, costume catalog, wallpapers, and active rental",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
  "/characters/{id}/oracle/blackmarket": {
    "post": {
      "description": "Checks if character meets level requirements to discover Black Market from Oracle Shop hint.",
      "operationId": "discoverOracleBlackMarket",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "unlocked": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "unlocked",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "Black Market discovery eligibility verified"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Bad Request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character job level insufficient (requires job_lv \u003e= 15)"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Check Black Market discovery from Oracle Shop",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
  "/characters/{id}/oracle/buy": {
    "post": {
      "description": "Purchases a costume consumable item from Oracle Shop with gold. Delivers to inventory (or routes overflow to depot) and records in item collection.",
      "operationId": "buyOracleCostume",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "item_no": {
                  "description": "Costume item number (e.g. 44..56, 138..141)",
                  "type": "integer"
                }
              },
              "required": [
                "item_no"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "delivered_to": {
                    "description": "Destination where item was delivered (inventory or depot)",
                    "type": "string"
                  },
                  "item_name": {
                    "type": "string"
                  },
                  "item_no": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "price": {
                    "type": "integer"
                  }
                },
                "required": [
                  "item_no",
                  "item_name",
                  "price",
                  "delivered_to",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "Costume purchased successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Insufficient gold, unavailable costume item, active helper quest conflict, or depot full"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Buy a costume consumable item",
      "tags": [
        "Oracle Shop"
      ]
    }
  },
