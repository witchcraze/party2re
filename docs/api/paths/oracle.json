  "/characters/{id}/oracle/wallpaper": {
    "post": {
      "description": "Purchases and applies a seasonal or scenic wallpaper for the character's private home estate.",
      "operationId": "buyOracleHomeWallpaper",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "wallpaper": {
                  "description": "Wallpaper identifier (e.g. stage10, stage11...)",
                  "type": "string"
                }
              },
              "required": [
                "wallpaper"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "price": {
                    "type": "integer"
                  },
                  "remaining_gold": {
                    "type": "integer"
                  },
                  "wallpaper": {
                    "type": "string"
                  }
                },
                "required": [
                  "wallpaper",
                  "price",
                  "remaining_gold",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "Home wallpaper purchased and applied successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Insufficient gold or invalid wallpaper identifier"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Purchase home wallpaper",
      "tags": [
        "Oracle Shop"
      ]
    }
  }
}
