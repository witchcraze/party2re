                    "type": "string"
                  },
                  "hint": {
                    "type": "string"
                  },
                  "location_name": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "npc_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "character_id",
                  "location_name",
                  "npc_name",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "NPC description and optional hint retrieved"
