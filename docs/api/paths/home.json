  "/homes/{id}": {
    "get": {
      "description": "Without visitor_id, returns only whitelisted public fields. A supplied visitor_id requires its owner session and is verified again by Home; it cannot authorize private fields by itself. Anonymous reads are supported. Supplying visitor_id requires Bearer authentication and visitor character ownership.",
      "operationId": "getHomeView",
      "parameters": [
        {
          "description": "Home / Owner Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Authenticated viewer character. Omit for anonymous public projection.",
          "in": "query",
          "name": "visitor_id",
          "required": false,
          "schema": {
            "maxLength": 128,
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HomeView"
              }
            }
          },
          "description": "Home view data"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Viewer session required"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Viewer is not owned"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Home character not found"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {},
        {
          "BearerAuth": []
        }
      ],
      "summary": "Get public or authenticated owned home view",
      "tags": [
        "Homes"
      ]
    }
  },
