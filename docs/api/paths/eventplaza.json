{
  "/eventplaza": {
    "get": {
      "description": "Retrieves displayed active population and a separate merchant_selection_count taken before expiry/duplicate cleanup. Selects the merchant from that snapshot, adds its presence, then cleans records for display. Observations can change the next request's tier; no real visitor heartbeat or reward is added.",
      "operationId": "getEventPlaza",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlazaStatus"
              }
            }
          },
          "description": "Event Plaza status retrieved successfully"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get Event Plaza status",
      "tags": [
        "EventPlaza"
      ]
    }
  },
  "/eventplaza/merchant/items": {
    "get": {
      "description": "Lists traveling merchant goods using the stored row count before this request adds merchant presence and cleans expired/duplicate records. The resulting tier can differ on the next observation or purchase; active display population does not determine the catalog.",
      "operationId": "getEventPlazaMerchantItems",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BazaarItemsResponse"
              }
            }
          },
          "description": "List of available traveling merchant goods"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "List traveling merchant items",
      "tags": [
        "EventPlaza"
      ]
    }
  },
  "/eventplaza/merchant/purchase": {
    "post": {
      "description": "Selects the merchant catalog from stored presence records before merchant insertion and display cleanup, then validates the purchase with concurrency-safe asset transaction locking. Re-evaluates the tier for this request rather than reusing a previous status or catalog response.",
      "operationId": "purchaseEventPlazaMerchantItem",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PurchaseBazaarItemRequest"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PurchaseBazaarItemResponse"
              }
            }
          },
          "description": "Item purchased successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Insufficient gold or invalid purchase request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - character belongs to another player or lacks permission"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character or item not found"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Item unavailable (requested by active helper quest) or depot storage full"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Purchase goods from traveling merchant",
      "tags": [
        "EventPlaza"
      ]
    }
  },
  "/eventplaza/presence": {
    "post": {
      "description": "Registers or refreshes character presence in the Event Plaza for real-time concurrency tracking.",
      "operationId": "recordEventPlazaPresence",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "character_id": {
                  "description": "Unique identifier of the character registering presence",
                  "type": "string"
                }
              },
              "required": [
                "character_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "status": {
                    "example": "ok",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Presence recorded successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - character belongs to another player"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Register character presence in Event Plaza",
      "tags": [
        "EventPlaza"
      ]
    }
  }
}
