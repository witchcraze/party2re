{
  "/rescues/penalty": {
    "get": {
      "operationId": "getRescuePenalty",
      "parameters": [
        {
          "description": "Character ID",
          "in": "query",
          "name": "character_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Rescue penalty status"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "summary": "Get emergency rescue penalty status",
      "tags": [
        "Rescues"
      ]
    }
  },
  "/rescues/request": {
    "post": {
      "operationId": "requestEmergencyRescue",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "character_id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "character_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Rescue record"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Request emergency rescue",
      "tags": [
        "Rescues"
      ]
    }
  }
}
