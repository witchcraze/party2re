{
  "/park/npc/divinate": {
    "post": {
      "operationId": "divinateParkNPC",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "character_id": {
                  "type": "string"
                }
              },
              "required": [
                "character_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParkDivinationResult"
              }
            }
          },
          "description": "Fortune divination result"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Conflict - character is currently sleeping or awaiting wake-up"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Get daily fortune divination from park NPC",
      "tags": [
        "Park"
      ]
    }
  },
