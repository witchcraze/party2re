        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get town park bulletin board posts",
      "tags": [
        "Park"
      ]
    },
    "post": {
      "operationId": "postParkMessage",
      "requestBody": {
