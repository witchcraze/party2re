  "/park/posts": {
    "get": {
      "operationId": "getParkPosts",
      "parameters": [
        {
          "description": "Number of posts to fetch",
          "in": "query",
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Offset from beginning of result set (default 0)",
          "in": "query",
          "name": "offset",
          "schema": {
            "default": 0,
            "type": "integer"
          }
        },
        {
          "description": "Opaque cursor for keyset pagination (e.g. returned in next_cursor)",
          "in": "query",
          "name": "cursor",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PaginationCursorPageParkPost"
                  },
                  {
                    "$ref": "#/components/schemas/PageParkPost"
                  }
                ]
              }
            }
          },
          "description": "Park board posts"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
