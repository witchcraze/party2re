{
  "/characters/{id}/secretshop": {
    "get": {
      "description": "Checks character eligibility and returns secret shop status and available rare items.",
      "operationId": "getSecretShopStatus",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "is_eligible": {
                    "type": "boolean"
                  },
                  "items": {
                    "items": {
                      "$ref": "#/components/schemas/SecretShopItem"
                    },
                    "type": "array"
                  },
                  "location_name": {
                    "type": "string"
                  },
                  "npc_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "character_id",
                  "location_name",
                  "npc_name",
                  "is_eligible",
                  "items"
                ],
                "type": "object"
              }
            }
          },
          "description": "Secret shop status retrieved successfully"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Access denied (character ineligible)"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Get Secret Shop status and available rare items",
      "tags": [
        "Secret Shop"
      ]
    }
  },
  "/characters/{id}/secretshop/inspect": {
    "post": {
      "description": "Retrieves character inspect description for the Secret Shop sheep NPC.",
      "operationId": "inspectSecretShopNPC",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "npc_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "character_id",
                  "npc_name",
                  "message"
                ],
                "type": "object"
              }
            }
          },
          "description": "NPC description returned successfully"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Access denied"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Inspect Secret Shop NPC @ヒミツジ",
      "tags": [
        "Secret Shop"
      ]
    }
  },
  "/characters/{id}/secretshop/puffpuff": {
    "post": {
      "description": "Interacts with @ヒミツジ for the legendary puff-puff massage service and restorative cheer.",
      "operationId": "experienceSecretShopPuffPuff",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "current_hp": {
                    "type": "integer"
                  },
                  "current_mp": {
                    "type": "integer"
                  },
                  "hp_healed": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  },
                  "mp_healed": {
                    "type": "integer"
                  },
                  "npc_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "character_id",
                  "npc_name",
                  "message",
                  "hp_healed",
                  "mp_healed",
                  "current_hp",
                  "current_mp"
                ],
                "type": "object"
              }
            }
          },
          "description": "Puff-puff service executed successfully"
        },
        "401": {
          "content": {
            "application/json": {
