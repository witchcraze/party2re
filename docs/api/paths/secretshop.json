              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Access denied"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Experience Secret Shop @ぱふぱふ service",
      "tags": [
        "Secret Shop"
      ]
    }
  },
  "/characters/{id}/secretshop/purchase": {
    "post": {
      "description": "Purchases rare item with transaction safety and updates gold/inventory.",
      "operationId": "purchaseSecretShopItem",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "item_id": {
                  "example": "secret_item_philosopher_stone",
                  "type": "string"
                },
                "quantity": {
                  "default": 1,
                  "maximum": 99,
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "item_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "inventory_instance_id": {
                    "type": "string"
                  },
                  "item": {
                    "$ref": "#/components/schemas/SecretShopItem"
                  },
                  "quantity": {
                    "type": "integer"
                  },
                  "remaining_gold": {
                    "type": "integer"
                  },
                  "total_price": {
                    "type": "integer"
                  }
                },
                "required": [
                  "character_id",
                  "item",
                  "quantity",
                  "total_price",
                  "remaining_gold",
                  "inventory_instance_id"
                ],
                "type": "object"
              }
            }
          },
          "description": "Item purchased successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Insufficient gold or invalid purchase parameters"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Access denied"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character or item not found"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Item temporarily unavailable due to active helper request"
        }
      },
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "summary": "Purchase rare item from Secret Shop",
      "tags": [
        "Secret Shop"
      ]
    }
  },
