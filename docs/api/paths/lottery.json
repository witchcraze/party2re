{
  "/characters/{id}/lottery/raffle": {
    "post": {
      "operationId": "playRaffle",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "raffle_type": {
                  "description": "Deprecated: raffle mode is automatically selected based on locked coupon balance (\u003e= 300: SPECIAL, \u003c 300: STANDARD). Maintained for backward compatibility.",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "required": false
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayRaffleResponse"
              }
            }
          },
          "description": "Raffle draw result"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "422": {
          "$ref": "#/components/responses/Error",
          "description": "Unprocessable Content"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Draw raffle ticket for item prizes",
      "tags": [
        "Lottery"
      ]
    }
  },
