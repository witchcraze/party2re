  "/gemstore/catalog": {
    "get": {
      "operationId": "getGemStoreCatalog",
      "parameters": [
        {
          "description": "Compatibility alias used only when job_level is absent.",
          "in": "query",
          "name": "level",
          "required": false,
          "schema": {
            "default": 0,
            "type": "integer"
          }
        },
        {
          "description": "Job level used to filter the catalog.",
          "in": "query",
          "name": "job_level",
          "required": false,
          "schema": {
            "default": 0,
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "gems": {
                    "items": {
                      "$ref": "#/components/schemas/GemStoreGem"
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "job_level": {
                    "type": "integer"
                  },
                  "level": {
                    "type": "integer"
                  }
                },
                "required": [
                  "gems",
                  "job_level",
                  "level"
                ],
                "type": "object"
              }
            }
          },
          "description": "Available gem catalog"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get gem catalog by level",
      "tags": [
        "GemStore"
      ]
    }
  },
