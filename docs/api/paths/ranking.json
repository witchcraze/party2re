{
  "/rankings/battles": {
    "get": {
      "operationId": "getBattleRanking",
      "parameters": [
        {
          "description": "Limit",
          "in": "query",
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Battle victories ranking"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "summary": "Get battle victories ranking leaderboard",
      "tags": [
        "Rankings"
      ]
    }
  },
