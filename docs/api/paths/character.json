  "/characters/{id}/avatar": {
    "post": {
      "description": "Uploads an avatar image (multipart form or JSON) for the character (max 2 MB, PNG/JPEG/GIF/WebP/SVG).",
      "operationId": "uploadCharacterAvatar",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "avatar_url": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "image_data": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "multipart/form-data": {
            "schema": {
              "properties": {
                "avatar": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Avatar uploaded and updated successfully"
        },
        "400": {
          "description": "Invalid format or image exceeds size limit"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "404": {
          "description": "Character not found"
        }
      },
      "summary": "Upload character avatar image",
      "tags": [
        "Character"
      ]
    }
  },
