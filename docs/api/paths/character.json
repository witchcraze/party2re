        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Delete character",
      "tags": [
        "Character"
      ]
    },
