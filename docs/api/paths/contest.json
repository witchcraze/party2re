{
  "/characters/{id}/contest/enter": {
    "post": {
      "description": "Submits a character's saved photo into the next preparing contest round.",
      "operationId": "enterContest",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "photo_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "photo_id",
                "title"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnterContestResponse"
              }
            }
          },
          "description": "Photo submitted to contest successfully"
        },
        "202": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnterContestResponse"
              }
            }
          },
          "description": "Photo submitted to contest successfully, but settlement scheduling deferred or failed"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Invalid submission (duplicate title, already entered, or consecutive entry disallowed)"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Photo or Character not found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Enter photo into upcoming contest",
      "tags": [
        "Contest"
      ]
    }
  },
  "/characters/{id}/contest/vote": {
    "post": {
      "description": "Casts a vote for a photo entry in the active contest round with an optional cheering comment.",
      "operationId": "voteContest",
      "parameters": [
        {
          "description": "Voter Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "comment": {
                  "type": "string"
                },
                "entry_id": {
                  "type": "string"
                }
              },
              "required": [
                "entry_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContestContestVote"
              }
            }
          },
          "description": "Vote cast successfully"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Invalid vote (contest not active, already voted, or comment too long)"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Entry or Character not found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Vote for a contest entry",
      "tags": [
        "Contest"
      ]
    }
  },
