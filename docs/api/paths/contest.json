      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "List character photos / screenshots",
      "tags": [
        "Contest"
      ]
    },
    "post": {
      "description": "Saves a new photo snapshot into the character's gallery (enforces max 20 capacity).",
      "operationId": "saveCharacterPhoto",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
