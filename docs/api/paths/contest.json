  "/contest/current": {
    "get": {
      "description": "Returns all photo submissions and current vote totals in the active contest round.",
      "operationId": "getContestCurrent",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/ContestContestEntry"
                },
                "type": [
                  "array",
                  "null"
                ]
              }
            }
          },
          "description": "Current contest entries retrieved successfully"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get current active contest submissions",
      "tags": [
        "Contest"
      ]
    }
  },
  "/contest/legends": {
    "get": {
      "description": "Returns historical 1st-place winning contest entries permanently archived in the Hall of Fame.",
      "operationId": "getContestLegends",
      "parameters": [
        {
          "description": "Max entries to return (default 20)",
          "in": "query",
          "name": "limit",
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Offset from beginning (default 0)",
          "in": "query",
          "name": "offset",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageContestLegend"
              }
            }
          },
          "description": "Contest legends retrieved successfully"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "List Hall of Fame contest legends",
      "tags": [
        "Contest"
      ]
    }
  },
  "/contest/past": {
    "get": {
      "description": "Returns rankings, votes, and community comments from the latest settled contest round.",
      "operationId": "getContestPast",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "entries": {
                    "items": {
                      "$ref": "#/components/schemas/ContestContestEntry"
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "round": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/ContestContestRound"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "round",
                  "entries"
                ],
                "type": "object"
              }
            }
          },
          "description": "Past contest results retrieved successfully"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get previous contest results",
      "tags": [
        "Contest"
      ]
    }
  },
  "/contest/settle": {
    "post": {
      "description": "Concludes active round, calculates rankings, awards prizes to top 3 and voters, archives 1st place into legends, and advances rounds.",
      "operationId": "settleContest",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "force": {
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          }
        },
        "required": false
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettleContestResponse"
              }
            }
          },
          "description": "Contest round settled successfully"
        },
        "202": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettleContestResponse"
              }
            }
          },
          "description": "Contest round settled successfully, but next settlement scheduling failed"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Contest round not ready to settle"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden (invalid or missing admin API key)"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Contest round not found"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "AdminApiKey": []
        }
      ],
      "summary": "Settle active contest round (Admin)",
      "tags": [
        "Contest"
      ]
    }
  },
  "/contest/venue": {
    "get": {
      "description": "Returns NPC @ワコール dialogue, overview of current and preparing contest rounds, and status.",
      "operationId": "getContestVenue",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContestVenueResponse"
