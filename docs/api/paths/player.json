{
  "/player/tokens": {
    "get": {
      "operationId": "listPlayerAPITokens",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "tokens": {
                    "items": {
                      "properties": {
                        "created_at": {
                          "format": "date-time",
                          "type": "string"
                        },
                        "expires_at": {
                          "format": "date-time",
                          "nullable": true,
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "last_used_at": {
                          "format": "date-time",
                          "nullable": true,
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "created_at"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "tokens"
                ],
                "type": "object"
              }
            }
          },
          "description": "List of active player tokens"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "List player personal access tokens",
      "tags": [
        "Player"
      ]
    },
    "post": {
      "operationId": "createPlayerAPIToken",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "expires_at": {
                  "description": "Optional expiration timestamp (RFC 3339)",
                  "format": "date-time",
                  "nullable": true,
                  "type": "string"
                },
                "name": {
                  "description": "Descriptive name for the API token",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "created_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "expires_at": {
                    "format": "date-time",
                    "nullable": true,
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "last_used_at": {
                    "format": "date-time",
                    "nullable": true,
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "token": {
                    "description": "Plaintext secret token. Only returned once upon creation.",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "created_at",
                  "token"
                ],
                "type": "object"
              }
            }
          },
          "description": "Personal access token created successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Invalid token parameters"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Create personal access token",
      "tags": [
        "Player"
      ]
    }
  },
  "/player/tokens/{id}": {
    "delete": {
      "operationId": "revokePlayerAPIToken",
      "parameters": [
        {
          "description": "Token ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "revoked": {
                    "type": "boolean"
                  },
                  "token_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "revoked",
                  "token_id"
                ],
                "type": "object"
              }
            }
          },
          "description": "Token revoked successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Token not found"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Revoke personal access token",
      "tags": [
        "Player"
      ]
    }
  },
  "/players/me": {
    "delete": {
      "operationId": "deletePlayerMe",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DeletePlayerRequest"
            }
          }
        },
        "required": false
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "deleted": {
                    "type": "boolean"
                  },
                  "player_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "deleted",
                  "player_id"
                ],
                "type": "object"
              }
            }
          },
          "description": "Player account deleted successfully"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Delete current player account",
      "tags": [
        "Player"
      ]
    }
  },
  "/players/{id}": {
    "delete": {
      "operationId": "deletePlayerByID",
      "parameters": [
        {
          "description": "Player ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/DeletePlayerRequest"
            }
          }
        },
        "required": false
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "deleted": {
                    "type": "boolean"
                  },
                  "player_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "deleted",
                  "player_id"
                ],
                "type": "object"
              }
            }
          },
          "description": "Player account deleted successfully"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Delete player account by ID",
      "tags": [
        "Player"
      ]
    }
  }
}
