{
  "/auction/hall": {
    "get": {
      "operationId": "getAuctionHall",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "dialogue": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "npc_name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "npc_name",
                  "dialogue"
                ],
                "type": "object"
              }
            }
          },
          "description": "Venue info and NPC dialogue"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Get auction hall information and NPC dialogue",
      "tags": [
        "Auctions"
      ]
    }
  },
  "/characters/{id}/auction/inspect": {
    "get": {
      "operationId": "getCharactersIdAuctionInspect",
      "parameters": [
        {
          "description": "id parameter",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target character ID",
          "in": "query",
          "name": "target_character_id",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target character name",
          "in": "query",
          "name": "target_name",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuctionInspectResult"
              }
            }
          },
          "description": "Inspected character information and equipped gear"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Bad request"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Target character not found"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Inspect another character's stats and equipped gear (@しらべる)",
      "tags": [
        "Auctions"
      ]
    }
  }
}
