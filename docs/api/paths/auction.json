{
  "/auctions": {
    "get": {
      "operationId": "listAuctions",
      "parameters": [
        {
          "description": "Limit",
          "in": "query",
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Offset",
          "in": "query",
          "name": "offset",
          "required": false,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PageAuctionListing"
              }
            }
          },
          "description": "Active auction listings"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "summary": "List active marketplace auction listings",
      "tags": [
        "Auctions"
      ]
    },
    "post": {
      "operationId": "createAuction",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "buyout_price": {
                  "type": "integer"
                },
                "duration_hours": {
                  "type": "integer"
                },
                "enhancement_level": {
                  "type": "integer"
                },
                "item_category": {
                  "type": "string"
                },
                "item_id": {
                  "type": "string"
                },
                "item_name": {
                  "type": "string"
                },
                "seller_character_id": {
                  "type": "string"
                },
                "start_bid": {
                  "type": "integer"
                }
              },
              "required": [
                "seller_character_id",
                "item_id",
                "item_name",
                "item_category",
                "start_bid",
                "buyout_price"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Auction listing created"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Create new item auction listing",
      "tags": [
        "Auctions"
      ]
    }
  },
  "/auctions/{id}": {
    "get": {
      "operationId": "getAuction",
      "parameters": [
        {
          "description": "Auction Listing ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "description": "Auction listing details"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
