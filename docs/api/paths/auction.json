{
  "/auction/hall": {
    "get": {
      "operationId": "getAuctionHall",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "dialogue": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "npc_name": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "npc_name",
                  "dialogue"
                ],
                "type": "object"
              }
            }
          },
          "description": "Venue info and NPC dialogue"
        },
        "500": {
          "description": "Internal server error"
        }
      },
      "summary": "Get auction hall information and NPC dialogue",
      "tags": [
        "Auctions"
      ]
    }
  },
  "/auction/send": {
    "post": {
      "operationId": "postAuctionSend",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "gold": {
                  "type": "integer"
                },
                "instance_id": {
                  "type": "string"
                },
                "sender_character_id": {
                  "type": "string"
                },
                "slot": {
                  "type": "string"
                },
                "target_character_id": {
                  "type": "string"
                },
                "target_character_name": {
                  "type": "string"
                }
              },
              "required": [
                "sender_character_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Successful transfer"
        },
        "400": {
          "description": "Bad request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "404": {
          "description": "Target or item not found"
        },
        "500": {
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Transfer gold or item to another player (legacy endpoint)",
      "tags": [
        "Auctions"
      ]
    }
  },
  "/characters/{id}/auction/inspect": {
    "get": {
      "operationId": "getCharactersIdAuctionInspect",
      "parameters": [
        {
          "description": "id parameter",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target character ID",
          "in": "query",
          "name": "target_character_id",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Target character name",
          "in": "query",
          "name": "target_name",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Inspected character information and equipped gear"
        },
        "400": {
          "description": "Bad request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "404": {
          "description": "Target character not found"
        },
        "500": {
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Inspect another character's stats and equipped gear (@しらべる)",
      "tags": [
        "Auctions"
      ]
    }
  },
  "/characters/{id}/auction/send": {
    "post": {
      "operationId": "postCharactersIdAuctionSend",
      "parameters": [
        {
          "description": "id parameter",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "gold": {
                  "type": "integer"
                },
                "instance_id": {
                  "type": "string"
                },
                "slot": {
                  "type": "string"
                },
                "target_character_id": {
                  "type": "string"
                },
                "target_character_name": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "description": "Successful transfer"
        },
        "400": {
          "description": "Bad request"
        },
        "401": {
          "description": "Unauthorized"
        },
        "403": {
          "description": "Forbidden"
        },
        "404": {
          "description": "Target or item not found"
        },
        "500": {
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Transfer gold or item directly to another player (@おくる)",
      "tags": [
        "Auctions"
      ]
    }
  }
}
