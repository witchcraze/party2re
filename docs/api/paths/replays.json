{
  "/replays/recent": {
    "get": {
      "description": "Only proven global records with verified safe display content may be published. No such publisher or payload support currently exists, so this endpoint returns an empty feed for every viewer. Personal and unclassified headers never appear, including through cursors.",
      "operationId": "getRecentReplays",
      "parameters": [
        {
          "description": "Optional combat type filter (e.g. pvp, gvg, boss, dungeon, adventure, challenge)",
          "in": "query",
          "name": "combat_type",
          "required": false,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Maximum number of replays to return",
          "in": "query",
          "name": "limit",
          "required": false,
          "schema": {
            "type": "integer"
          }
        },
        {
          "description": "Opaque cursor for keyset pagination",
          "in": "query",
          "name": "cursor",
          "required": false,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/PaginationCursorPageReplayReplayHeader"
                  },
                  {
                    "items": {
                      "$ref": "#/components/schemas/ReplayHeader"
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                ]
              }
            }
          },
          "description": "Recent public battle replays"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "Retrieve global public recent match feed with limit and cursor pagination",
      "tags": [
        "Replay"
      ]
    }
  },
  "/replays/{id}": {
    "get": {
      "description": "Personal archive detail requires a valid Bearer session owning the persisted archive recipient. Combat participation and UUID possession grant no access. Unknown/unclassified records and unauthorized IDs return the same 404. Invalid supplied credentials return authentication errors. Global display payloads remain unavailable until a verified publisher and safe scene contract exist. Anonymous reads are supported. Supplying Authorization requires a valid player credential; replay visibility is still enforced by the service.",
      "operationId": "getReplay",
      "parameters": [
        {
          "description": "Unique battle replay UUID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ReplayBattleReplay"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "description": "Structured battle replay document with participant snapshots and turn logs"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid replay id"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Invalid supplied session"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Player is banned"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Replay absent, unclassified, unsupported public payload, or viewer does not own the personal archive recipient"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {},
        {
          "BearerAuth": []
        }
      ],
      "summary": "Retrieve an owned personal replay archive by ID",
      "tags": [
        "Replay"
      ]
    }
  }
}
