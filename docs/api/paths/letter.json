{
  "/letters": {
    "post": {
      "operationId": "sendLetter",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": false,
              "properties": {
                "color": {
                  "description": "Optional; trimmed, defaults to #000000 when blank, and is truncated to 7 bytes. No hexadecimal color validation is performed.",
                  "type": "string"
                },
                "content": {
                  "description": "Nonblank multiline text; validated after whitespace trimming and NFC normalization, with a maximum of 1000 Unicode characters. Disallowed controls, zero-width/bidi formatting and excessive combining marks return 422.",
                  "minLength": 1,
                  "pattern": "[^\t-\r    - \u2028\u2029  　]",
                  "type": "string"
                },
                "recipient_character_id": {
                  "description": "Recipient character ID; must differ from the sender after trimming whitespace.",
                  "minLength": 1,
                  "pattern": "[^\t-\r    - \u2028\u2029  　]",
                  "type": "string"
                },
                "sender_character_id": {
                  "minLength": 1,
                  "pattern": "[^\t-\r    - \u2028\u2029  　]",
                  "type": "string"
                }
              },
              "required": [
                "sender_character_id",
                "recipient_character_id",
                "content"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Letter"
              }
            }
          },
          "description": "Letter sent successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Conflict - character is currently sleeping or awaiting wake-up"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "422": {
          "$ref": "#/components/responses/Error",
          "description": "Invalid recipient, self-send, blank or overlong normalized content, or text validation failure. Missing or blank sender ID is rejected earlier by the ownership wrapper with 400."
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Send letter to another character",
      "tags": [
        "Letters"
      ]
    }
  },
