      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "item_id": {
                  "description": "Item instance ID to deposit into storage",
                  "type": "string"
                }
              },
              "required": [
                "item_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DepotResponse"
              }
            }
          },
          "description": "Successful operation"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Bad request"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Deposit Depot Item",
      "tags": [
        "Depot"
      ]
    }
  },
