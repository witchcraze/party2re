  "/characters/{id}/depot/deposit": {
    "post": {
      "operationId": "postCharactersIdDepotDeposit",
      "parameters": [
        {
          "description": "id parameter",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
