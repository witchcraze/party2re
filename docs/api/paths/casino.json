{
  "/casino/prizes": {
    "get": {
      "operationId": "getCasinoPrizes",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "prizes": {
                    "items": {
                      "$ref": "#/components/schemas/CasinoPrize"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "prizes"
                ],
                "type": "object"
              }
            }
          },
          "description": "Successful operation"
        }
      },
      "security": [],
      "summary": "Get Casino Prizes",
      "tags": [
        "Casino"
      ]
    }
  },
  "/casino/rooms": {
    "get": {
      "description": "Anonymous lobby of at most 100 active rooms. Cards, marks, actions and private member state are excluded. Casino-owned idle expiry/index pruning may remove stale rooms; failures return 500. No gameplay advancement or admission.",
      "operationId": "getCasinoRooms",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "rooms": {
                    "items": {
                      "$ref": "#/components/schemas/CasinoRoomSummary"
                    },
                    "maxItems": 100,
                    "type": "array"
                  }
                },
                "required": [
                  "rooms"
                ],
                "type": "object"
              }
            }
          },
          "description": "Bounded lobby; empty rooms is []"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Required expiry or storage failure"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Casino service not configured"
        }
      },
      "security": [],
      "summary": "List safe public casino lobby summaries",
      "tags": [
        "Casino"
      ]
    }
  },
  "/casino/rooms/{roomId}": {
    "get": {
      "description": "character_id selects an owned character, never an arbitrary viewer. Service verifies authenticated player ownership and actual participant or admitted spectator membership. Game-specific card/mark/action masking applies in active rounds; completed rounds reveal results only to admitted viewers. GET never joins, spectates, starts, advances or settles a game, or refreshes room lifetime.",
      "operationId": "getCasinoRoomsRoomId",
      "parameters": [
        {
          "description": "roomId parameter",
          "in": "path",
          "name": "roomId",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Owned character used as viewer; requires existing room admission.",
          "in": "query",
          "name": "character_id",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "room": {
                    "$ref": "#/components/schemas/CasinoRoomView"
                  }
                },
                "required": [
                  "room"
                ],
                "type": "object"
              }
            }
          },
          "description": "Whitelisted viewer projection"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Bad request"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Character belongs to another player or is not admitted to this room"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Character or room missing, disbanded or expired"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Casino service not configured"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Observe a casino room as an owned admitted character",
      "tags": [
        "Casino"
      ]
    }
  },
