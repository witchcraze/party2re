{
  "/characters/{id}/altar": {
    "get": {
      "operationId": "getAltarStatus",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "available_items": {
                    "items": {
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "awakened_by": {
                    "type": "string"
                  },
                  "character_id": {
                    "type": "string"
                  },
                  "has_all_orbs": {
                    "type": "boolean"
                  },
                  "miko_dialogue": {
                    "type": "string"
                  },
                  "orb_count": {
                    "type": "integer"
                  },
                  "orbs": {
                    "type": "string"
                  },
                  "ramia_awakened": {
                    "type": "boolean"
                  },
                  "ramia_expires_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "ramia_present": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Altar status and orb offering progression"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Character not found"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Get Altar of Rebirth status, orb collection, and Ramia presence",
      "tags": [
        "Altar"
      ]
    }
  },
  "/characters/{id}/altar/offer": {
    "post": {
      "operationId": "offerAltarOrb",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "orb": {
                  "description": "Orb symbol (s, r, b, g, y, p) or Japanese name",
                  "type": "string"
                }
              },
              "required": [
                "orb"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "has_all_orbs": {
                    "type": "boolean"
                  },
                  "message": {
                    "type": "string"
                  },
                  "orb": {
                    "type": "string"
                  },
                  "orb_name": {
                    "type": "string"
                  },
                  "total_orbs": {
                    "type": "integer"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Orb offered successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid orb symbol"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character"
        },
        "409": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Conflict - orb has already been offered"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Offer an orb to the Altar of Rebirth",
      "tags": [
        "Altar"
      ]
    }
  },
  "/characters/{id}/altar/pray": {
    "post": {
      "operationId": "prayAltarRamia",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "expires_at": {
                    "format": "date-time",
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "ramia_awakened": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Ramia awakened successfully"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - insufficient orbs to awaken Ramia"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Pray to awaken legendary phoenix Ramia (@いのる)",
      "tags": [
        "Altar"
      ]
    }
  },
  "/characters/{id}/altar/wish": {
    "post": {
      "operationId": "wishAltarTravelItem",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "item_id": {
                  "description": "Secret otherworld travel item ID",
                  "enum": [
                    "item-066",
                    "item-067",
                    "item-068",
                    "item-069"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "item_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "character_id": {
                    "type": "string"
                  },
                  "delivered_to": {
                    "enum": [
                      "inventory",
                      "depot"
                    ],
                    "type": "string"
                  },
                  "item_id": {
                    "type": "string"
                  },
                  "item_name": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "description": "Wish granted and item delivered"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - Ramia not awakened or invalid travel item"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Make a wish for an otherworld travel item (@ねがう)",
      "tags": [
        "Altar"
      ]
    }
  }
}
