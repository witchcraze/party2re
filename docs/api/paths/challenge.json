  "/characters/{id}/challenges/advance": {
    "post": {
      "description": "Computes combat from the active session snapshot and atomically applies a victory only if its session and round still match. Concurrent computations of the same round receive HTTP 409 after the first victory commits; observe the current run before continuing.",
      "operationId": "advanceChallengeRound",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "session_id": {
                  "type": "string"
                }
              },
              "required": [
                "session_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvanceChallengeResponse"
              }
            }
          },
          "description": "Round battle result and session state"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "422": {
          "$ref": "#/components/responses/Error",
          "description": "Unprocessable Content"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Advance continuous challenge round battle",
      "tags": [
        "Combat"
      ]
    }
  },
  "/characters/{id}/challenges/party-start": {
    "post": {
      "description": "Starts from the authenticated leader’s saved, ready Party roster. member_ids is optional; when supplied it must contain every saved member exactly once. Cross-account participants are allowed through their own lobby consent. Every member must be idle; nonleaders may observe their enrolled run but only the leader advances or ends it.",
      "operationId": "startPartyChallenge",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "member_ids": {
                  "description": "Optional assertion of the complete saved Party roster; arbitrary, duplicate or omitted members are rejected.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "party_color": {
                  "type": "string"
                },
                "party_name": {
                  "type": "string"
                },
                "tier_id": {
                  "type": "string"
                }
              },
              "required": [
                "tier_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeSessionResponse"
              }
            }
          },
          "description": "Started challenge session"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Only the saved party leader may start the run"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "409": {
          "$ref": "#/components/responses/Error",
          "description": "Conflict"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "422": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Party is not ready, a member is busy, or an entry condition is unmet"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error. For the start outcome sentinel (the start failed after publication and could not be confirmed) the run is preserved: observe the active run before retrying and never replay the start."
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Start a party continuous challenge run",
      "tags": [
        "Combat"
      ]
    }
  },
