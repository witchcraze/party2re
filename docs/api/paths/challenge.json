  "/characters/{id}/challenges/active": {
    "get": {
      "description": "Read-only: never publishes, settles, cleans up or renews TTL. Missing live state with an unfinished SQL claim remains visible as recovery_pending.",
      "operationId": "getActiveChallenge",
      "parameters": [
        {
          "description": "Owned Character ID",
          "in": "path",
          "name": "id",
          "required": true,
