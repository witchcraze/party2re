          "description": "Bad request"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Start a party continuous challenge run",
      "tags": [
        "Combat"
      ]
    }
  },
