  "/characters/{id}/challenges/{session_id}/commands/{revision}": {
    "get": {
      "description": "Read-only: never publishes, settles, cleans up or renews TTL. The path revision is the command expected_revision. Start uses revision 0. Only the authenticated character may read their result, including after departure. An absent or foreign receipt returns 404.",
      "operationId": "getChallengeCommandResult",
      "parameters": [
        {
          "description": "Owned Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Immutable run ID",
          "in": "path",
          "name": "session_id",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "description": "Command expected revision",
          "in": "path",
          "name": "revision",
          "required": true,
          "schema": {
            "minimum": 0,
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChallengeCommandResult"
              }
            }
          },
          "description": "Original actor-owned command result"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "No command result owned by this character"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Read an actor-owned Challenge command receipt",
      "tags": [
        "Combat"
      ]
    }
