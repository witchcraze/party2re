{
  "/characters/{id}/blackmarket": {
    "get": {
      "description": "Returns current Black Market status, points balances, and prize catalogs for an authenticated character.",
      "operationId": "getBlackMarketStatus",
      "parameters": [
        {
          "description": "Character ID",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlackMarketStatus"
              }
            }
          },
          "description": "Black market status and trade prize catalogs"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "500": {
          "$ref": "#/components/responses/InternalServerError"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Get black market status and prize catalogs",
      "tags": [
        "Black Market"
      ]
    }
  },
