{
  "/helpers/complete": {
    "post": {
      "description": "Attempts completion and exchanges expired uncompleted requests one-for-one. Submitting an expired quest_id obtained from GET /helpers/quests returns 422 without turn-in or reward, but exchanges that expired request and the other expired requests. Fetch the board again after this response. An empty store is never seeded.",
      "operationId": "completeHelperQuest",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "character_id": {
                  "type": "string"
                },
                "quest_id": {
                  "type": "string"
                }
              },
              "required": [
                "character_id",
                "quest_id"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HelperQuestCompletionResult"
              }
            }
          },
          "description": "Quest completion result"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "401": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Unauthorized - missing or invalid session token"
        },
        "403": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Forbidden - player does not own requested character or lacks permission"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "422": {
          "$ref": "#/components/responses/Error",
          "description": "Completion rejected (including an expired target); expired requests may already have been exchanged. Fetch GET /helpers/quests again."
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Complete helper quest",
      "tags": [
        "Helpers"
      ]
    }
  },
  "/helpers/quests": {
    "get": {
      "description": "Read-only board of all uncompleted requests, including expired requests; completed requests are excluded. Submit an expired quest_id to POST /helpers/complete to trigger exchange, then fetch this board again even when completion returns 422. An empty board returns [] and is never seeded.",
      "operationId": "listHelperQuests",
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "items": {
                  "$ref": "#/components/schemas/HelperQuestQuest"
                },
                "type": "array"
              }
            }
          },
          "description": "Uncompleted helper quests, including expired requests"
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Bad request - invalid input or JSON syntax"
        },
        "500": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ErrorResponse"
              }
            }
          },
          "description": "Internal server error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "List uncompleted helper delivery quests",
      "tags": [
        "Helpers"
      ]
    }
  }
}
