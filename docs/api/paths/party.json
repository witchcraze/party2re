{
  "/parties": {
    "get": {
      "description": "Lists recruiting or active multiplayer parties.",
      "operationId": "listParties",
      "parameters": [
        {
          "in": "query",
          "name": "status",
          "schema": {
            "default": "recruiting",
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "limit",
          "schema": {
            "default": 50,
            "type": "integer"
          }
        },
        {
          "in": "query",
          "name": "offset",
          "schema": {
            "default": 0,
            "type": "integer"
          }
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PagePartySummary"
              }
            }
          },
          "description": "List of parties"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [],
      "summary": "List parties",
      "tags": [
        "Party"
      ]
    },
    "post": {
      "description": "Creates a new multiplayer party with the authenticated character as leader.",
      "operationId": "createParty",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/CreatePartyRequest"
            }
          }
        },
        "required": true
      },
      "responses": {
        "201": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartyDetail"
              }
            }
          },
          "description": "Party created successfully"
        },
        "400": {
          "$ref": "#/components/responses/Error",
          "description": "Invalid party parameters or character already in party"
        },
        "401": {
          "$ref": "#/components/responses/Error",
          "description": "Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Error",
          "description": "Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/Error",
          "description": "Not Found"
        },
        "415": {
          "$ref": "#/components/responses/Error",
          "description": "Unsupported Media Type"
        },
        "500": {
          "$ref": "#/components/responses/Error",
          "description": "Internal Server Error"
        },
        "501": {
          "$ref": "#/components/responses/Error",
          "description": "Not Implemented"
        }
      },
      "security": [
        {
          "BearerAuth": []
        }
      ],
      "summary": "Create party",
      "tags": [
        "Party"
      ]
    }
  },
